# Protected Coolify runtime environment variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=https://your-app.example.de
# Enable only during first account creation, then set false and redeploy.
BETTER_AUTH_ENABLE_SIGNUP=false
EUROJACKPOT_SOURCE_URL=https://raw.githubusercontent.com/protomultix/eurojackpot-api/main/public/api/draws.json
SYNC_INTERVAL_HOURS=6

# Only for authenticated scheduled synchronization
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Optional: verified HTTPS endpoint returning draw-date and prize-class quoten in JSON
# EUROJACKPOT_QUOTAS_URL=https://your-trusted-source.example/quotas.json
